# Copy to .env locally. On Vercel, set these under Project Settings > Environment Variables.
#
# Required for Luna AI chat (/ai) — get a key from console.groq.com
GROQ_API_KEY=
#
# Supabase is embedded in index.html constants, no env needed unless you
# want to rotate/override (set in Vercel env AND supabase-keepalive secrets).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
#
# Port is auto-set by Vercel; only for local dev.
# PORT=8080
